theme_override_font_sizes/bold_font_size = 13
theme_override_font_sizes/italics_font_size = 13
bbcode_enabled = true
text = "[b]Git LFS[/b] stores large binaries (textures, models, audio) outside Git history and keeps small pointers in the repo: smaller repo, faster clones, and it avoids GitHub's 100 MiB file limit.
Uploads run inside git push and downloads inside Pull: both obey the network timeout setting [i](default 120s)[/i], [b]large assets may need a higher value[/b]. [font size=11]GitHub limits LFS storage and bandwidth: [url=https://docs.github.com/en/repositories/working-with-files/managing-large-files/about-storage-and-bandwidth-usage]quota details[/url]. (GitHub Free: 10 GiB)[/font]"
fit_content = true

[node name="PruneConfirmDialog" type="ConfirmationDialog" parent="." unique_id=1711788682]
unique_name_in_owner = true
oversampling_override = 1.0
